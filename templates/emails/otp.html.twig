<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
</head>

<body style="margin:0;padding:0;background:#f5f5f5;font-family:'Poppins',Arial,sans-serif;color:#333;">

<table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="background:#f5f5f5;padding:20px 0;"
>

<tr>

<td align="center">

<table
    width="600"
    cellpadding="0"
    cellspacing="0"
    style="
        background:#ffffff;
        border-radius:10px;
        overflow:hidden;
        box-shadow:0 2px 10px rgba(0,0,0,.08);
    "
>

<!-- HEADER -->

<tr>

<td
    align="center"
    style="background:#0171c2;padding:25px;"
>

<a
    href="{{ frontend_url }}"
    style="text-decoration:none;"
>

<img
    src="{{ logo }}"
    alt="TOLI-TOLI"
    width="110"
>

</a>

</td>

</tr>

<!-- BODY -->

<tr>

<td
    align="center"
    style="padding:40px;"
>

<h1
    style="
        margin:0;
        color:#444;
        font-size:30px;
    "
>

Hi {{ name }} 👋

</h1>

<h2
    style="
        margin-top:20px;
        color:#0171c2;
    "
>

Welcome to TOLI-TOLI

</h2>

<p
    style="
        color:#555;
        line-height:1.7;
        font-size:15px;
    "
>

Thank you for creating your account.

To activate your account, please verify your email address using the One-Time Password (OTP) below.

</p>

<div
    style="
        display:inline-block;
        margin:30px 0;
        background:#eef7ff;
        border:1px solid #d9e8f6;
        border-radius:8px;
        padding:18px 30px;
        letter-spacing:12px;
        font-size:32px;
        font-weight:bold;
        color:#222;
    "
>

{{ otp }}

</div>

<p
    style="
        color:#ff9800;
        font-size:14px;
    "
>

⚠ This OTP expires in <strong>10 minutes</strong>.

</p>

<p
    style="
        color:#666;
        line-height:1.6;
        margin-top:30px;
    "
>

If you didn't create this account, you can safely ignore this email.

</p>

</td>

</tr>

<!-- FOOTER -->

<tr>

<td
    align="center"
    style="
        background:#171717;
        padding:25px;
        color:#cccccc;
        font-size:13px;
    "
>

<div style="margin-bottom:15px;">

<a
href="{{ frontend_url }}/about-us"
style="color:#ccc;text-decoration:none;"
>

About

</a>

&nbsp;|&nbsp;

<a
href="{{ frontend_url }}/contact-us"
style="color:#ccc;text-decoration:none;"
>

Contact

</a>

&nbsp;|&nbsp;

<a
href="{{ frontend_url }}/privacy-policy"
style="color:#ccc;text-decoration:none;"
>

Privacy Policy

</a>

&nbsp;|&nbsp;

<a
href="{{ frontend_url }}/terms-of-service"
style="color:#ccc;text-decoration:none;"
>

Terms of Service

</a>

</div>

<p style="margin:0;">

© {{ "now"|date("Y") }} TOLI-TOLI. All Rights Reserved.

</p>

</td>

</tr>

</table>

</td>

</tr>

</table>

</body>

</html>